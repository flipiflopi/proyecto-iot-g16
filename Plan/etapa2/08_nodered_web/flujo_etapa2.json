  {
    "id": "e2func0000000001",
    "type": "function",
    "z": "e2tab000000000001",
    "name": "Línea -> JSON",
    "func": "// Línea de la base: \"O,id,yaw,pitch,roll,botones\"\nconst p = String(msg.payload).trim().split(',');\nif (p[0] !== 'O' || p.length < 6) return null;   // ignora líneas que no son de orientación\nconst datos = {\n    id: Number(p[1]),\n    yaw: Number(p[2]),\n    pitch: Number(p[3]),\n    roll: Number(p[4]),\n    disparo: Number(p[5]) & 1\n};\nif (Object.values(datos).some(Number.isNaN)) return null;  // línea corrupta\nmsg.payload = JSON.stringify(datos);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
